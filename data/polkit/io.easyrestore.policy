<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>EasyRestore</vendor>
  <vendor_url>https://github.com</vendor_url>
  <action id="io.easyrestore.Helper.getdevicemode">
    <description>Read the connected iPhone or iPad mode</description>
    <message>EasyRestore wants to detect your device over USB.</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="io.easyrestore.Helper.runpreflight">
    <description>Run EasyRestore pre-flight checks</description>
    <message>EasyRestore wants to prepare your computer for a restore.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.easyrestore.Helper.startrestore">
    <description>Restore an iPhone or iPad with EasyRestore</description>
    <message>EasyRestore wants to restore your device. This can erase data on the device.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
